# Normalize cross-platform line endings
* text=auto

# Define macros for LFS and Unity YAML handling
[attr]lfs filter=lfs diff=lfs merge=lfs -text
[attr]unity-yaml merge=unityyamlmerge eol=lf
[attr]unity-json eol=lf

# ------------------------------------------------------------------------------
# 1. Unity Code & Text Assets (Handled by Git)
# ------------------------------------------------------------------------------
*.cs            text diff=csharp
*.cginc         text
*.compute       text
*.hlsl          text
*.raytrace      text
*.shader        text

# Unity JSON / Config
*.asmdef        unity-json
*.asmref        unity-json
*.index         unity-json
*.inputactions  unity-json
*.json          text
*.shadergraph   unity-json
